const Player = require("../models/player");
const riotService = require("./riotService");

// Get player with caching
async function getPlayerByRiotId(gameName, tagLine) {
  // Check if player is already in db
  const existingPlayer = await Player.findOne({ gameName, tagLine });

  if (existingPlayer) {
    console.log("Player cache hit");
    return existingPlayer;
  }

  console.log("Player cache miss");

  // If not exist, call it using riot's API
  const account = await riotService.getAccountByRiotId(gameName, tagLine);

  // Create new player schema for db
  const newPlayer = await Player.create({
    gameName,
    tagLine,
    puuid: account.puuid
  });

  console.log("Inserted player:", newPlayer);
  
  return newPlayer;
}

// get puuid
async function getPlayerByPUUID(puuid) {
  return await Player.findOne({ puuid });
}

module.exports = {
  getPlayerByRiotId,
  getPlayerByPUUID
};